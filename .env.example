# Backend configuration

# SQLite database URL.
# The database file is stored in the ./backend/data directory.
DATABASE_URL=sqlite:///./data/practicelab.db

# Origins allowed to call the backend directly from a browser.
# Port 5173 is the local Vite development server.
CORS_ORIGINS=http://localhost:5173


# Frontend configuration

VITE_API_BASE_URL=/api/v1

