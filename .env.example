# Docker Compose configuration.
# Compose reads ./.env automatically. Copy this file to .env to override defaults.

# Host port for the frontend (Nginx). Default: 8080
FRONTEND_PORT=8080

# Allowed CORS origins for the backend container.
# Default: http://localhost:${FRONTEND_PORT}
# CORS_ORIGINS=http://localhost:8080

# Image names used by Compose. Leave unset for local development
# (defaults: practicelab-backend:local, practicelab-frontend:local).
# CI sets these to the images built by build-images.yml.
# BACKEND_IMAGE=
# FRONTEND_IMAGE=